{
    "name": "etf",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "add:etf": "python scripts/utils/add_etfs_by_provider.py",
        "backfill-market-cap": "python scripts/data_pipeline/backfill_market_cap_approximate.py",
        "generate-nav": "node tasks/generateNav.js",
        "generate-sidebar-tickers": "python scripts/utils/generateSidebar.py",
        "generate-calendar-events": "node tasks/generateCalendarEvents.js",
        "fetch-logos": "node tasks/fetchMissingLogos.js",
        "watch-nav": "nodemon --watch public/nav --ext json --exec \"npm run generate-nav\"",
        "dev": "vite",
        "build": "vite build",
        "add-ipo-dates": "node tasks/addIpoDatesToNav.js",
        "check:kr-suffix": "node scripts/utils/checkKrTickerSuffixes.js",
        "preview": "vite preview",
        "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
        "lint:eslint": "eslint . --fix",
        "lint": "npm-run-all lint:*",
        "format:changed": "bash scripts/format_changed_files.sh",
        "format:changed:win": "powershell -ExecutionPolicy Bypass -File scripts/format_changed_files.ps1",
        "format:data": "prettier --write \"public/data/**/*.json\" --log-level=warn",
        "format:nav": "prettier --write \"public/nav/**/*.json\" --log-level=warn",
        "format:calendar": "prettier --write \"public/calendar-events.json\",\"public/calendar/*.json\" --log-level=warn",
        "format:nav.json": "prettier --write \"public/nav.json\" --log-level=warn",
        "format:public": "prettier --write \"public/*.json\" --log-level=warn",
        "format": "prettier --write src/ --log-level=warn",
        "data:sort-keys": "node tasks/sortDataKeys.js"
    },
    "dependencies": {
        "@fullcalendar/core": "^6.1.19",
        "@fullcalendar/daygrid": "^6.1.19",
        "@fullcalendar/google-calendar": "^6.1.19",
        "@fullcalendar/interaction": "^6.1.19",
        "@fullcalendar/list": "^6.1.19",
        "@fullcalendar/vue3": "^6.1.19",
        "@primeuix/themes": "^1.2.3",
        "@primevue/core": "^4.3.7",
        "@vercel/analytics": "^1.5.0",
        "@vueuse/head": "^2.0.0",
        "axios": "^1.12.2",
        "date-fns": "^4.1.0",
        "echarts": "^5.6.0",
        "firebase": "^12.1.0",
        "formidable": "^3.5.4",
        "html2canvas": "^1.4.1",
        "image-size": "^1.1.1",
        "jszip": "^3.10.1",
        "playwright": "^1.56.1",
        "primeflex": "^4.0.0",
        "primeicons": "^7.0.0",
        "primevue": "^4.3.7",
        "terser": "^5.44.0",
        "ufo": "^1.6.1",
        "vue": "^3.5.19",
        "vue-echarts": "^7.0.3",
        "vue-router": "^4.5.1",
        "web-streams-polyfill": "^4.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.34.0",
        "@primevue/auto-import-resolver": "^4.3.7",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/eslint-config-prettier": "^10.2.0",
        "cheerio": "^1.0.0",
        "eslint": "^9.34.0",
        "eslint-plugin-oxlint": "~1.12.0",
        "eslint-plugin-vue": "~10.4.0",
        "firebase-admin": "^13.6.0",
        "gh-pages": "^6.3.0",
        "globals": "^16.3.0",
        "nodemon": "^3.1.10",
        "npm-run-all": "^4.1.5",
        "oxlint": "~1.12.0",
        "prettier": "3.6.2",
        "sass": "^1.90.0",
        "sass-embedded": "^1.90.0",
        "unplugin-auto-import": "^20.0.0",
        "unplugin-vue-components": "^29.0.0",
        "vite": "^7.1.3",
        "vite-plugin-vue-devtools": "^8.0.0",
        "yahoo-finance2": "^2.13.3"
    }
}
