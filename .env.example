# Sentry Configuration
# Sentry DSN (프로덕션 환경에서만 사용)
# 가입: https://sentry.io
VITE_SENTRY_DSN=

# App Version (package.json에서 자동으로 가져올 수도 있음)
VITE_APP_VERSION=1.0.0

# Environment
# development | production | test
VITE_ENV=development

# Application mode
# content-studio (default) | legacy-portfolio
VITE_APP_MODE=content-studio

# Optional Notion content calendar sync. Never commit real credentials.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
