# Sentry Configuration
# Sentry DSN (프로덕션 환경에서만 사용)
# 가입: https://sentry.io
VITE_SENTRY_DSN=

# App Version (package.json에서 자동으로 가져올 수도 있음)
VITE_APP_VERSION=1.0.0

# Environment
# development | production | test
VITE_ENV=development

# Application mode
# content-studio (default) | legacy-portfolio
VITE_APP_MODE=content-studio

# Content Studio refresh API. Server-side values are required before dispatch;
# CONTENT_REFRESH_REF is deliberately blank to prevent accidental main runs.
VITE_CONTENT_REFRESH_API_BASE=
GITHUB_ACTIONS_TOKEN=
GITHUB_REPOSITORY=totobubu/totobubu.github.io
CONTENT_REFRESH_REF=
CONTENT_REFRESH_ALLOWED_ORIGINS=

# Optional licensed fallback. Values are stored as third_party_only
# observations and never become canonical events automatically.
MASSIVE_API_KEY=

# Optional Notion content calendar sync. Never commit real credentials.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
